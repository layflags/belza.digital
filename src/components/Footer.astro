---
import Signet from './Signet.astro';
import type { Dict } from '../i18n/types';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
---

<footer>
  <div class="wrap foot-in">
    <Signet idPrefix="ft" class="foot-sig" />
    <span>© 2014–2026 Belza Digital GmbH · Munich</span>
    <span class="sp">
      <a href="/impressum">{t.nav.imprint}</a>
      <a href="https://github.com/layflags" target="_blank" rel="noopener">GitHub</a>
      <a href="https://www.linkedin.com/in/martinbelza" target="_blank" rel="noopener">LinkedIn</a>
      <a href="mailto:martin@belza.digital">Email</a>
    </span>
  </div>
</footer>
