---
import Base from '../layouts/Base.astro';
import Impressum from '../components/Impressum.astro';
import { getDict } from '../i18n';
import '../styles/impressum.css';

const locale = 'en';
const t = getDict(locale);
---

<Base title={t.imprint.title} lang="en" noindex={true}>
  <Impressum locale={locale} t={t} />
  <script>
    import '../scripts/lang.ts';
  </script>
</Base>
