---
import Base from '../../layouts/Base.astro';
import HomeHead from '../../components/HomeHead.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Stats from '../../components/Stats.astro';
import Services from '../../components/Services.astro';
import Work from '../../components/Work.astro';
import About from '../../components/About.astro';
import Testimonial from '../../components/Testimonial.astro';
import SideProjects from '../../components/SideProjects.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { getDict } from '../../i18n';
import '../../styles/home.css';

const locale = 'de';
const t = getDict(locale);
---

<Base title="Martin Belza — Frontend Architect · Belza Digital" lang="de">
  <HomeHead slot="head" locale={locale} />

  <Header locale={locale} t={t} />
  <main id="top">
    <div class="wrap">
      <Hero t={t} />
      <Stats t={t} />
      <Services t={t} />
      <Work t={t} />
      <About t={t} />
      <Testimonial t={t} />
      <SideProjects t={t} />
    </div>
    <Contact t={t} />
  </main>
  <Footer t={t} locale={locale} />

  <script>
    import '../../scripts/lang.ts';
    import '../../scripts/reveal.ts';
    import '../../scripts/parallax.ts';
  </script>
</Base>
